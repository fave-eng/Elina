      "items": [
        {
          "id": "1",
          "number": 1,
          "prompt": "My friend Lukas is from …",
          "input": "single",
          "options": [
            "Germany",
            "Arabic",
            "Japan",
            "All three expressions fit"
          ],
          "answer": 1,
          "explanation": "Arabic is a language, not a country."
        },
        {
          "id": "2",
          "number": 2,
          "prompt": "My sister's a …",
          "input": "single",
          "options": [
            "translator",
            "civil servant",
            "engineer",
            "All three expressions fit"
          ],
          "answer": 3,
          "explanation": "All three are jobs."
        },
        {
          "id": "3",
          "number": 3,
          "prompt": "My mum works in a …",
